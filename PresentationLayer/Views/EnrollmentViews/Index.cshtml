@{
    ViewData["Title"] = "Enrollments";
}
@model IEnumerable<DataAccessLayer.Models.Enrollment>

<div class="flex flex-col w-full">
    <!-- Top Action & Stats Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-lg mb-space-2xl">
        <div>
            <div class="flex items-center gap-space-xs text-on-surface-variant text-label-sm uppercase tracking-wider mb-space-2xs">
                <span class="material-symbols-outlined text-[14px]">assignment</span>
                <span>Candidate Admissions</span>
            </div>
            <h1 class="font-headline-xl text-on-surface tracking-tight">Enrollment Management</h1>
        </div>
        <div class="flex items-center gap-space-md">
            <div class="flex items-center gap-space-xs bg-surface-container-low px-space-md py-space-sm rounded-xl shadow-sm">
                <span class="text-body-sm text-on-surface-variant">Active Tracks:</span>
                <span class="font-headline-sm text-on-surface">@Model.Count()</span>
            </div>
            <a asp-controller="Enrollments" asp-action="Create" class="flex items-center gap-space-xs bg-primary text-on-primary px-space-lg py-space-sm rounded-xl font-label-md hover:bg-primary/90 transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>New Enrollment</span>
            </a>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-surface-container-low p-space-md rounded-2xl shadow-sm mb-space-xl flex flex-col md:flex-row gap-space-md items-center justify-between">
        <div class="relative flex-1 md:w-80 max-w-md">
            <span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input class="w-full bg-surface text-on-surface text-body-md pl-10 pr-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="enrollment-search" placeholder="Search by trainee or course..." type="text" onkeyup="filterEnrollments()" />
        </div>
    </div>

    <!-- Enrollments Table Container -->
    <div class="bg-surface-container-low rounded-2xl shadow-sm overflow-hidden mb-space-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container border-b border-surface-variant/20 text-on-surface-variant text-label-sm uppercase tracking-wider">
                        <th class="py-space-md px-space-lg font-medium">Trainee</th>
                        <th class="py-space-md px-space-lg font-medium">Course Track</th>
                        <th class="py-space-md px-space-lg font-medium">Department</th>
                        <th class="py-space-md px-space-lg font-medium">Status</th>
                        <th class="py-space-md px-space-lg font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant/10 text-body-md text-on-surface" id="enrollment-table-body">

                    @foreach (var enrollment in Model)
                    {
                        <tr class="enrollment-row hover:bg-surface-container/50 transition-colors group">
                            <td class="py-space-md px-space-lg">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-headline-sm text-label-md">
                                        @((enrollment.Trainee?.Name ?? "").Split(' ').Select(s => s.FirstOrDefault()).Take(2).Aggregate("", (a,b)=>a+ (b==0?"":b)))
                                    </div>
                                    <div>
                                        <div class="enrollment-trainee font-headline-sm text-on-surface">@enrollment.Trainee?.Name</div>
                                        <div class="text-body-sm text-on-surface-variant">@enrollment.Trainee?.Address</div>
                                    </div>
                                </div>
                            </td>
                            <td class="enrollment-course py-space-md px-space-lg font-medium text-on-surface">
                                @enrollment.Course?.Name
                            </td>
                            <td class="py-space-md px-space-lg text-on-surface-variant">
                                @(enrollment.Course?.Department?.Name ?? "General Track")
                            </td>
                            <td class="py-space-md px-space-lg">
                                <span class="inline-flex items-center px-space-sm py-space-3xs rounded-full text-label-sm bg-secondary-fixed text-on-secondary-fixed font-medium">
                                    Active
                                </span>
                            </td>
                            <td class="py-space-md px-space-lg text-right">
                                <div class="flex items-center justify-end gap-space-xs opacity-80 group-hover:opacity-100 transition-opacity">
                                    <form asp-controller="Enrollments" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to remove this enrollment?');" class="inline">
                                        <input type="hidden" name="traineeId" value="@enrollment.TraineeId" />
                                        <input type="hidden" name="courseId" value="@enrollment.CourseId" />
                                        <button type="submit" class="p-space-xs hover:bg-error-container/20 rounded-lg text-error transition-colors" title="Delete Enrollment">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterEnrollments() {
            const term = document.getElementById("enrollment-search").value.toLowerCase();
            const rows = document.querySelectorAll(".enrollment-row");
            rows.forEach(row => {
                const trainee = row.querySelector(".enrollment-trainee").textContent.toLowerCase();
                const course = row.querySelector(".enrollment-course").textContent.toLowerCase();
                const matches = trainee.includes(term) || course.includes(term);
                row.style.display = matches ? "" : "none";
            });
        }
    </script>
}