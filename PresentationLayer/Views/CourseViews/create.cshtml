@model DataAccessLayer.Models.Course

@{
    ViewData["Title"] = "Add New Course";
}

<div class="flex flex-col w-full max-w-4xl mx-auto">

    <!-- Top Action & Title Bar -->
    <div class="flex items-center justify-between mb-space-xl">
        <div>
            <div class="flex items-center gap-space-xs text-on-surface-variant text-label-sm uppercase tracking-wider mb-space-2xs">
                <span class="material-symbols-outlined text-[14px]">library_add</span>
                <span>Curriculum Operations</span>
            </div>
            <h1 class="font-headline-xl text-on-surface tracking-tight">Add Course</h1>
        </div>
        <a asp-action="Index" class="flex items-center gap-space-xs px-space-md py-space-sm bg-surface-container-low border border-outline-variant/30 text-on-surface rounded-xl font-label-md hover:bg-surface-container-high transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to List</span>
        </a>
    </div>

    <!-- Form Container -->
    <div class="bg-surface-container-low rounded-2xl shadow-sm p-space-xl border border-outline-variant/20">

        <form asp-action="Create" method="post" class="flex flex-col gap-space-lg">

            <div asp-validation-summary="All" class="text-error text-label-sm bg-error-container/20 rounded-lg p-3 empty:hidden"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">

                <!-- Course Name Input -->
                <div class="flex flex-col gap-space-2xs">
                    <label asp-for="Name" class="text-label-sm font-medium text-on-surface-variant">Course Name</label>
                    <input asp-for="Name" class="w-full bg-surface text-on-surface text-body-md px-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all border border-outline-variant/30 shadow-sm" placeholder="e.g. Advanced React & TypeScript" />
                    <span asp-validation-for="Name" class="text-error text-[12px] mt-1"></span>
                </div>

                <!-- Minimum Degree Input -->
                <div class="flex flex-col gap-space-2xs">
                    <label asp-for="MinDegree" class="text-label-sm font-medium text-on-surface-variant">Minimum Degree (%)</label>
                    <input asp-for="MinDegree" type="number" class="w-full bg-surface text-on-surface text-body-md px-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all border border-outline-variant/30 shadow-sm" placeholder="75" />
                    <span asp-validation-for="MinDegree" class="text-error text-[12px] mt-1"></span>
                </div>

                <!-- Department Dropdown -->
                <div class="flex flex-col gap-space-2xs">
                    <label asp-for="DepartmentId" class="text-label-sm font-medium text-on-surface-variant">Department</label>
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="w-full bg-surface text-on-surface text-body-md px-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all border border-outline-variant/30 shadow-sm">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-error text-[12px] mt-1"></span>
                </div>

                <!-- Lead Instructor Dropdown -->
                <div class="flex flex-col gap-space-2xs">
                    <label asp-for="InstructorId" class="text-label-sm font-medium text-on-surface-variant">Lead Instructor</label>
                    <select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="w-full bg-surface text-on-surface text-body-md px-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all border border-outline-variant/30 shadow-sm">
                        <option value="">-- Select Instructor  --</option>
                    </select>
                    <span asp-validation-for="InstructorId" class="text-error text-[12px] mt-1"></span>
                </div>

            </div>

            <div class="border-t border-surface-variant/30 my-space-xs"></div>

            <!-- Submit & Cancel Actions -->
            <div class="flex items-center justify-end gap-space-sm">
                <a asp-action="Index" class="px-space-md py-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors text-label-md">
                    Cancel
                </a>
                <button type="submit" class="flex items-center gap-space-xs px-space-lg py-space-sm rounded-xl bg-primary text-on-primary font-label-md hover:bg-primary/90 transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>Create Course</span>
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}