@{
    ViewData["Title"] = "Instructors";
}
@model IEnumerable<DataAccessLayer.Models.Instructor>

<div class="flex flex-col w-full">
    <!-- Top Action & Stats Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-lg mb-space-2xl">
        <div>
            <div class="flex items-center gap-space-xs text-on-surface-variant text-label-sm uppercase tracking-wider mb-space-2xs">
                <span class="material-symbols-outlined text-[14px]">supervisor_account</span>
                <span>Faculty &amp; Staff Directory</span>
            </div>
            <h1 class="font-headline-xl text-on-surface tracking-tight">Instructor Management</h1>
        </div>
        <div class="flex items-center gap-space-md">
            <div class="flex items-center gap-space-xs bg-surface-container-low px-space-md py-space-sm rounded-xl shadow-sm">
                <span class="text-body-sm text-on-surface-variant">Total Faculty:</span>
                <span class="font-headline-sm text-on-surface">@Model.Count()</span>
            </div>
            <a asp-controller="Instructors" asp-action="Create" class="flex items-center gap-space-xs bg-primary text-on-primary px-space-lg py-space-sm rounded-xl font-label-md hover:bg-primary/90 transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>Add Instructor</span>
            </a>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-surface-container-low p-space-md rounded-2xl shadow-sm mb-space-xl flex flex-col md:flex-row gap-space-md items-center justify-between">
        <div class="flex flex-wrap items-center gap-space-sm w-full md:w-auto">

            <!-- Search Input -->
            <div class="relative flex-1 md:w-80">
                <span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
                <input class="w-full bg-surface text-on-surface text-body-md pl-10 pr-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all" id="instructor-search" placeholder="Search by name or email..." type="text" onkeyup="filterTable()" />
            </div>

            <!-- Dynamic Department Dropdown -->
            <select id="department-filter" class="bg-surface text-on-surface text-body-md px-space-md py-space-sm rounded-xl focus:outline-none focus:ring-1 focus:ring-secondary transition-all" onchange="filterTable()">
                <option value="">All Departments</option>
                @if (ViewBag.AllDepartments != null)
                {
                    foreach (var dept in ViewBag.AllDepartments)
                    {
                        <option value="@dept.Name">@dept.Name</option>
                    }
                }
            </select>

        </div>
    </div>

    <!-- Instructors Table Container -->
    <div class="bg-surface-container-low rounded-2xl shadow-sm overflow-hidden mb-space-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="instructors-table">
                <thead>
                    <tr class="bg-surface-container border-b border-surface-variant/20 text-on-surface-variant text-label-sm uppercase tracking-wider">
                        <th class="py-space-md px-space-lg font-medium">Instructor Name</th>
                        <th class="py-space-md px-space-lg font-medium">Department</th>
                        <th class="py-space-md px-space-lg font-medium">Salary</th>
                        <th class="py-space-md px-space-lg font-medium text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-variant/10 text-body-md text-on-surface">
                    @foreach (var instructor in Model)
                    {
                        <tr class="instructor-row hover:bg-surface-container/50 transition-colors group">
                            <td class="py-space-md px-space-lg">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-headline-sm text-label-md">
                                        @instructor.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="instructor-name font-headline-sm text-on-surface">@instructor.Name</div>
                                        <div class="instructor-address text-body-sm text-on-surface-variant">@instructor.Address</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg">
                                <span class="instructor-dept inline-flex items-center px-space-sm py-space-3xs rounded-full text-label-sm bg-secondary-fixed text-on-secondary-fixed">
                                    @(instructor.Department?.Name ?? "None")
                                </span>
                            </td>
                            <td class="py-space-md px-space-lg text-on-surface-variant">
                                @instructor.Salary.ToString("C")
                            </td>
                            <td class="py-space-md px-space-lg text-right">
                                <div class="flex items-center justify-end gap-space-xs opacity-80 group-hover:opacity-100 transition-opacity">
                                    <a asp-controller="Instructors" asp-action="Edit" asp-route-id="@instructor.Id" class="p-space-xs hover:bg-surface-container-high rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" title="Edit Instructor">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <form asp-controller="Instructors" asp-action="Delete" asp-route-id="@instructor.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this instructor?');" class="inline">
                                        <button type="submit" class="p-space-xs hover:bg-error-container/20 rounded-lg text-error transition-colors" title="Delete">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Instant Search & Filter JavaScript Script -->
@section Scripts {
    <script>
        function filterTable() {
            const searchText = document.getElementById("instructor-search").value.toLowerCase();
            const selectedDept = document.getElementById("department-filter").value.toLowerCase();
            const rows = document.querySelectorAll(".instructor-row");

            rows.forEach(row => {
                const name = row.querySelector(".instructor-name").textContent.toLowerCase();
                const address = row.querySelector(".instructor-address").textContent.toLowerCase();
                const dept = row.querySelector(".instructor-dept").textContent.trim().toLowerCase();

                const matchesSearch = name.includes(searchText) || address.includes(searchText);
                const matchesDept = selectedDept === "" || dept === selectedDept;

                if (matchesSearch && matchesDept) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }
    </script>
}